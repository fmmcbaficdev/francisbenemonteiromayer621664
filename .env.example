# ============================================
# PROJETO - Configuracoes Gerais
# ============================================
COMPOSE_PROJECT_NAME=ppfullstack621664

# ============================================
# POSTGRESQL
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=seplag
POSTGRES_USER=seplag
POSTGRES_PASSWORD=your_postgres_password_here

# ============================================
# MINIO (S3-compatible Object Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_NAME=seplag-bucket
MINIO_PRESIGNED_URL_EXPIRY_MINUTES=30

# ============================================
# JWT (Autenticacao)
# ============================================
# IMPORTANTE: JWT_SECRET deve ser uma string Base64-encoded
# Gere com: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_here
JWT_EXPIRATION=300000
JWT_REFRESH_EXPIRATION=86400000

# ============================================
# BACKEND
# ============================================
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
RATE_LIMIT_REQUESTS_PER_MINUTE=10
EXTERNAL_REGIONAIS_API_URL=https://api.example.com/regionais
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
JAVA_OPTS=-Xms512m -Xmx1024m
SPRING_PROFILES_ACTIVE=prod

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8080
