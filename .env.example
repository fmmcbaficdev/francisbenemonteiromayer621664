# COMPOSE
COMPOSE_PROJECT_NAME=seplag
SPRING_PROFILES_ACTIVE=prod

# POSTGRESQL
POSTGRES_DB=seplag
POSTGRES_USER=seplag
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MINIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_URL=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=seplag-albuns
MINIO_PRESIGNED_URL_EXPIRY_MINUTES=30


# JWT
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_EXPIRATION=300000
JWT_REFRESH_EXPIRATION=86400000


# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# RATE LIMITING
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# EXTERNAL API
EXTERNAL_REGIONAIS_API_URL=https://integrador-argus-api.geia.vip/v1/regionais


# LOGGING
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG


# PORTS
BACKEND_PORT=8080
FRONTEND_PORT=3000

# REACT APP
REACT_APP_API_URL=http://localhost:8080
