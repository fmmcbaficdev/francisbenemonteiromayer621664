# ============================================
# PROJETO - Configuracoes Gerais
# ============================================
COMPOSE_PROJECT_NAME=ppfullstack621664

# ============================================
# POSTGRESQL
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=seplag
POSTGRES_USER=seplag
POSTGRES_PASSWORD=seplag123

# ============================================
# MINIO (S3-compatible Object Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_NAME=seplag-bucket
MINIO_PRESIGNED_URL_EXPIRY_MINUTES=30

# ============================================
# JWT (Autenticacao)
# ============================================
# Para avaliação: use o valor abaixo (mínimo 32 caracteres).
# Em produção: openssl rand -base64 64
JWT_SECRET=AVALIADOR_DEMO_SECRET_SEPLAG_PSS_2026_MINIMO_32_CHARS
JWT_EXPIRATION=300000
JWT_REFRESH_EXPIRATION=86400000

# ============================================
# BACKEND
# ============================================
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
RATE_LIMIT_REQUESTS_PER_MINUTE=10
# URL da API de regionais (edital: https://integrador-argus-api.geia.vip/v1/regionais)
EXTERNAL_REGIONAIS_API_URL=https://integrador-argus-api.geia.vip/v1/regionais
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
JAVA_OPTS=-Xms512m -Xmx1024m
SPRING_PROFILES_ACTIVE=prod

# ============================================
# FRONTEND (build time - Vite usa VITE_*)
# ============================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws
